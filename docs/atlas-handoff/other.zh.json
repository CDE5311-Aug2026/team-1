 "routes": [
  {
   "id": "clementi-community",
   "title": "金文泰 · 一餐看懂邻里",
   "subtitle": "巴刹、潮州庙宇与多族群餐桌",
   "duration": "约 2–3 小时",
   "note": "两处熟食中心适合各选一小份，不必吃两顿正餐。清真寺只按接待规则参观；路程需经过真实过街设施。顺序为编辑建议，非地图实时计算。"
  },
  {
   "id": "sunset-way",
   "title": "斜阳大道 · 老味道与河岸",
   "subtitle": "旧式西饼、乌鲁班丹水道、社区冰淇淋",
   "duration": "约 2–3 小时",
   "note": "先确认水道段开放情况；旧铁路桥另外收藏，禁止按桥面过河。若连道临时关闭，可保留西饼与冰淇淋两站。"
  },
  {
   "id": "nus-rainy-day",
   "title": "国大 · 两座博物馆的半天",
   "subtitle": "亚洲艺术与东南亚自然史",
   "duration": "约 3.5–4.5 小时",
   "note": "从金文泰搭公交到大学文化中心一带，馆间步行。两馆共同适合到访日通常是周二至周六，公假及局部展区更新须核对。"
  },
  {
   "id": "telok-ayer",
   "title": "直落亚逸 · 一条街的信仰",
   "subtitle": "把移民登陆史放进同一段步行",
   "duration": "约 2–3 小时",
   "note": "同街的文化机构有不同接待规则；以下只显示已完成卡片的地点。请逐一查看预约及宗教礼仪。"
  },
  {
   "id": "katong",
   "title": "加东 · 走进土生华人日常",
   "subtitle": "街屋、家藏与特色餐桌",
   "duration": "约半天",
   "note": "私人家藏与历史住宅须先预约。照片中的街屋仍有人居住，保持在公共道路活动。"
  }
